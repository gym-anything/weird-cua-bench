{
  "id": "weird_captcha_gym.silent_colleague_env@0.1",
  "version": "0.1",
  "base": "ubuntu-gnome-systemd_highres",
  "description": "Coordinate a preservation line with a wordless autonomous colleague by reading motion, yielding on a shared loop, handing off the requested fruit, and meeting expiring paired-press windows.",
  "category": ["visual_puzzle", "captcha_inspired", "computer_use"],
  "authors": ["captcha-bench contributors"],
  "resources": {"cpu": 2, "mem_gb": 4, "gpu": 0, "net": false},
  "observation": [{"type": "frame_window", "fps": 7, "resolution": [1920, 1080], "inline": false}],
  "action": [{"type": "mouse"}, {"type": "keyboard"}],
  "runner": "weird_captcha",
  "runner_options": {"observation_window_ms": 900, "frames_per_observation": 6, "play_time_seconds": 180},
  "synchronous": true,
  "step_cycle_ms": 150,
  "recording": {"enable": false, "output_dir": "weird_captcha_gym/environments/silent_colleague_env/artifacts"},
  "vnc": {"enable": false, "host_port": 6189, "view_only": false, "password": "password"},
  "security": {"user": "root", "cap_drop": ["ALL"], "privileged": true, "use_systemd": true, "mount_cgroups": true, "cgroupns_host": true, "tmpfs_run": true, "runtime": "sysbox-runc"},
  "mounts": [
    {"source": "weird_captcha_gym/environments/silent_colleague_env/scripts", "target": "/workspace/scripts", "mode": "ro"},
    {"source": "weird_captcha_gym/environments/silent_colleague_env/tasks", "target": "/workspace/tasks", "mode": "ro"},
    {"source": "weird_captcha_gym/shared_runtime", "target": "/workspace/shared_runtime", "mode": "ro"},
    {"source": "weird_captcha_gym/shared_scripts", "target": "/workspace/shared_scripts", "mode": "ro"}
  ],
  "hooks": {"pre_start": "/workspace/scripts/install_puzzle_runtime.sh", "post_start": "/workspace/scripts/setup_puzzle_runtime.sh"},
  "tags": ["linux", "browser", "visual-puzzle", "weird-captcha", "silent-colleague", "multi-agent-coordination", "real-time"]
}
