{
  "id": "weird_captcha_gym.orchard_exchange_env@0.1",
  "version": "0.1",
  "base": "ubuntu-gnome-systemd_highres",
  "description": "Harvest, eat, and settle reciprocal stock-backed barter in a living orchard.",
  "category": [
    "visual_puzzle",
    "captcha_inspired",
    "computer_use"
  ],
  "authors": [
    "captcha-bench contributors"
  ],
  "resources": {
    "cpu": 2,
    "mem_gb": 4,
    "gpu": 0,
    "net": false
  },
  "observation": [
    {
      "type": "frame_window",
      "fps": 10,
      "resolution": [
        1920,
        1080
      ],
      "inline": false
    }
  ],
  "action": [
    {
      "type": "mouse"
    },
    {
      "type": "keyboard"
    }
  ],
  "runner": "weird_captcha",
  "runner_options": {
    "play_time_seconds": 180,
    "observation_window_ms": 500,
    "frames_per_observation": 3
  },
  "synchronous": true,
  "step_cycle_ms": 160,
  "recording": {
    "enable": false,
    "output_dir": "weird_captcha_gym/environments/orchard_exchange_env/artifacts"
  },
  "vnc": {
    "enable": false,
    "host_port": 6145,
    "view_only": false,
    "password": "password"
  },
  "security": {
    "user": "root",
    "cap_drop": [
      "ALL"
    ],
    "privileged": true,
    "use_systemd": true,
    "mount_cgroups": true,
    "cgroupns_host": true,
    "tmpfs_run": true,
    "runtime": "sysbox-runc"
  },
  "mounts": [
    {
      "source": "weird_captcha_gym/environments/orchard_exchange_env/scripts",
      "target": "/workspace/scripts",
      "mode": "ro"
    },
    {
      "source": "weird_captcha_gym/environments/orchard_exchange_env/tasks",
      "target": "/workspace/tasks",
      "mode": "ro"
    },
    {
      "source": "weird_captcha_gym/shared_runtime",
      "target": "/workspace/shared_runtime",
      "mode": "ro"
    },
    {
      "source": "weird_captcha_gym/shared_scripts",
      "target": "/workspace/shared_scripts",
      "mode": "ro"
    }
  ],
  "hooks": {
    "pre_start": "/workspace/scripts/install_puzzle_runtime.sh",
    "post_start": "/workspace/scripts/setup_puzzle_runtime.sh"
  },
  "tags": [
    "linux",
    "browser",
    "visual-puzzle",
    "weird-captcha",
    "barter",
    "resource-planning"
  ]
}
