{
  "id": "weird_captcha_gym.rubes_last_piece_env@0.1",
  "version": "0.1",
  "base": "ubuntu-gnome-systemd_highres",
  "description": "Place and aim physical deflectors in a serial flight chain, match rebound energy to calibrated receivers, observe seeded crosswind, rewind, and iterate until the final bell rings.",
  "category": ["visual_puzzle", "captcha_inspired", "computer_use"],
  "authors": ["captcha-bench contributors"],
  "resources": {"cpu": 2, "mem_gb": 4, "gpu": 0, "net": false},
  "observation": [{"type": "frame_window", "fps": 6, "resolution": [1920, 1080], "inline": false}],
  "action": [{"type": "mouse"}, {"type": "keyboard"}],
  "runner": "weird_captcha",
  "runner_options": {"observation_window_ms": 1200, "frames_per_observation": 6, "play_time_seconds": 180},
  "synchronous": true,
  "step_cycle_ms": 100,
  "recording": {"enable": false, "output_dir": "weird_captcha_gym/environments/rubes_last_piece_env/artifacts"},
  "vnc": {"enable": false, "host_port": 6180, "view_only": false, "password": "password"},
  "security": {"user": "root", "cap_drop": ["ALL"], "privileged": true, "use_systemd": true, "mount_cgroups": true, "cgroupns_host": true, "tmpfs_run": true, "runtime": "sysbox-runc"},
  "mounts": [
    {"source": "weird_captcha_gym/environments/rubes_last_piece_env/scripts", "target": "/workspace/scripts", "mode": "ro"},
    {"source": "weird_captcha_gym/environments/rubes_last_piece_env/tasks", "target": "/workspace/tasks", "mode": "ro"},
    {"source": "weird_captcha_gym/shared_runtime", "target": "/workspace/shared_runtime", "mode": "ro"},
    {"source": "weird_captcha_gym/shared_scripts", "target": "/workspace/shared_scripts", "mode": "ro"}
  ],
  "hooks": {"pre_start": "/workspace/scripts/install_puzzle_runtime.sh", "post_start": "/workspace/scripts/setup_puzzle_runtime.sh"},
  "tags": ["linux", "browser", "visual-puzzle", "weird-captcha", "rubes-last-piece", "causal-physics", "trajectory", "tool-placement"]
}
