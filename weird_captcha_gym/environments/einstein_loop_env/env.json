{
  "id": "weird_captcha_gym.einstein_loop_env@0.1",
  "version": "0.1",
  "base": "ubuntu-gnome-systemd_highres",
  "description": "Trace one exact loop through a generated patch of congruent hat monotiles while grounding every clue to its irregular boundary.",
  "category": [
    "visual_puzzle",
    "captcha_inspired",
    "computer_use"
  ],
  "authors": [
    "captcha-bench contributors"
  ],
  "resources": {
    "cpu": 2,
    "mem_gb": 4,
    "gpu": 0,
    "net": false
  },
  "observation": [
    {
      "type": "frame_window",
      "fps": 1,
      "resolution": [
        1920,
        1080
      ],
      "inline": false
    }
  ],
  "action": [
    {"type": "mouse"},
    {"type": "keyboard"}
  ],
  "runner": "weird_captcha",
  "runner_options": {
    "observation_window_ms": 0,
    "frames_per_observation": 1,
    "play_time_seconds": 300
  },
  "synchronous": true,
  "step_cycle_ms": 100,
  "recording": {
    "enable": false,
    "output_dir": "weird_captcha_gym/environments/einstein_loop_env/artifacts"
  },
  "vnc": {
    "enable": false,
    "host_port": 6208,
    "view_only": false,
    "password": "password"
  },
  "security": {
    "user": "root",
    "cap_drop": ["ALL"],
    "privileged": true,
    "use_systemd": true,
    "mount_cgroups": true,
    "cgroupns_host": true,
    "tmpfs_run": true,
    "runtime": "sysbox-runc"
  },
  "mounts": [
    {
      "source": "weird_captcha_gym/environments/einstein_loop_env/scripts",
      "target": "/workspace/scripts",
      "mode": "ro"
    },
    {
      "source": "weird_captcha_gym/environments/einstein_loop_env/tasks",
      "target": "/workspace/tasks",
      "mode": "ro"
    },
    {
      "source": "weird_captcha_gym/shared_runtime",
      "target": "/workspace/shared_runtime",
      "mode": "ro"
    },
    {
      "source": "weird_captcha_gym/shared_scripts",
      "target": "/workspace/shared_scripts",
      "mode": "ro"
    }
  ],
  "hooks": {
    "pre_start": "/workspace/scripts/install_puzzle_runtime.sh",
    "post_start": "/workspace/scripts/setup_puzzle_runtime.sh"
  },
  "tags": [
    "linux",
    "browser",
    "visual-puzzle",
    "weird-captcha",
    "slitherlink",
    "aperiodic-tiling",
    "topology"
  ]
}
